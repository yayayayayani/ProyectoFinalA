{% extends 'base.html.twig' %}
{% block title %}{{ jugador.nombreCompleto }}{% endblock %}
{% block body %}
<a class="back-link" href="{{ path('app_jugador_index') }}">← Jugadores</a>
<div class="page-heading"><div><p class="eyebrow">FICHA DEL JUGADOR</p><h1>{{ jugador.nombreCompleto }}</h1><p class="subtitle">Toda su información y trayectoria en el torneo.</p></div>{% if is_granted('ROLE_ADMIN') %}<a class="button primary" href="{{ path('app_jugador_edit',{id:jugador.id}) }}">Editar jugador</a>{% endif %}</div>
{% set totalGoles = 0 %}{% for g in goles %}{% set totalGoles = totalGoles + g.cantidad %}{% endfor %}
<section class="panel player-profile"><div class="profile-photo">{{ include('jugador/_fotografia.html.twig') }}</div><div><span class="badge green">{{ jugador.equipo.nombre }}</span><h2>{{ jugador.nombreCompleto }}</h2><p>Nacimiento: {{ jugador.fechaNacimiento|date('d/m/Y') }} · Registro #{{ '%03d'|format(jugador.id) }}</p>{% if jugador.fotografia and not (jugador.fotografia matches '/^[a-f0-9]{32}\\.(jpg|png|webp)$/') %}<small>Referencia de fotografía anterior: {{ jugador.fotografia }}</small>{% endif %}</div><div class="profile-total"><strong>{{ totalGoles }}</strong><span>goles anotados</span></div></section>
<div class="dashboard-grid"><section class="panel"><div class="panel-heading"><h2>Goles por jornada</h2>{% if is_granted('ROLE_ADMIN') %}<a class="text-link" href="{{ path('app_registro_new',{modulo:'gol'}) }}">+ Registrar</a>{% endif %}</div><div class="table-scroll"><table><thead><tr><th>Jornada</th><th>Fecha</th><th>Goles</th></tr></thead><tbody>{% for g in goles %}<tr><td>{{ g.jornada.nombre }}</td><td>{{ g.jornada.fecha|date('d/m/Y') }}</td><td><strong>{{ g.cantidad }}</strong></td></tr>{% else %}<tr><td colspan="3" class="empty">Aún no tiene goles registrados.</td></tr>{% endfor %}</tbody></table></div></section><section class="panel"><div class="panel-heading"><h2>Incidencias y suspensiones</h2></div>{% for i in incidencias %}<div class="profile-incident"><span class="badge {{ i.tipoTarjeta }}">Tarjeta {{ i.tipoTarjeta }}</span><small>{{ i.fechaIncidencia|date('d/m/Y') }}</small><p>{{ i.descripcion }}</p>{% if i.fechaSuspension %}<strong class="suspension">Suspendido el {{ i.fechaSuspension|date('d/m/Y') }}</strong>{% endif %}</div>{% else %}<p class="empty">Sin incidencias. ¡A seguir jugando limpio!</p>{% endfor %}</section></div>
{% endblock %}
