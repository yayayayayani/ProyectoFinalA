{% extends 'base.html.twig' %}{% block title %}{{ registro.id ? 'Editar' : 'Registrar' }} {{ singular }}{% endblock %}{% block body %}<a class="back-link" href="{{ path('app_registro_index',{modulo:modulo}) }}">← {{ titulo }}</a><div class="page-heading"><div><p class="eyebrow">GESTIÓN DEL TORNEO</p><h1>{{ registro.id ? 'Editar' : 'Registrar' }} {{ singular }}</h1><p class="subtitle">Completa la información del registro.</p></div></div><section class="panel form-panel">{{ form_start(form,{attr:{class:'entity-form'}}) }}{{ form_widget(form) }}<div class="form-actions"><button class="button primary">Guardar {{ modulo == 'gol' ? 'goles' : singular }}</button><a class="button secondary" href="{{ path('app_registro_index',{modulo:modulo}) }}">Cancelar</a></div>{{ form_end(form) }}</section>{% if registro.id %}<div class="danger-zone"><form method="post" action="{{ path('app_registro_delete',{modulo:modulo,id:registro.id}) }}" data-confirm="¿Eliminar este registro? Esta acción no se puede deshacer."><input type="hidden" name="_token" value="{{ csrf_token('delete_' ~ modulo ~ '_' ~ registro.id) }}"><button class="button danger">Eliminar registro</button></form></div>{% endif %}{% endblock %}
