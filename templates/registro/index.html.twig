{% extends 'base.html.twig' %}{% block title %}{{ titulo }}{% endblock %}{% block body %}
<div class="page-heading"><div><p class="eyebrow">{{ modulo == 'jornada' ? 'EL CALENDARIO DEL TORNEO' : (modulo == 'gol' ? 'CADA GOL CUENTA' : 'RESPETO DENTRO DE LA CANCHA') }}</p><h1>{{ titulo }}</h1><p class="subtitle">{{ modulo == 'jornada' ? 'Prepara las jornadas y fechas de juego desde el inicio del torneo.' : (modulo == 'gol' ? 'Registra los goles de cada jugador por jornada.' : 'Lleva el control de tarjetas y fechas de suspensión.') }}</p></div>{% if is_granted('ROLE_ADMIN') %}<a class="button primary" href="{{ path('app_registro_new',{modulo:modulo}) }}">+ {{ modulo == 'jornada' ? 'Crear jornada' : (modulo == 'gol' ? 'Registrar goles' : 'Registrar incidencia') }}</a>{% endif %}</div>
<section class="panel"><div class="panel-heading"><h2>Registros del torneo</h2><span class="badge neutral">{{ registros|length }} registros</span></div><div class="table-scroll"><table><thead><tr>{% if modulo == 'jornada' %}<th>Jornada</th><th>Fecha de juego</th>{% elseif modulo == 'gol' %}<th>Jugador</th><th>Equipo</th><th>Jornada</th><th>Goles</th>{% else %}<th>Jugador</th><th>Tarjeta</th><th>Descripción</th><th>Fecha</th><th>Suspensión</th>{% endif %}{% if is_granted('ROLE_ADMIN') %}<th>Acciones</th>{% endif %}</tr></thead><tbody>{% for r in registros %}<tr>{% if modulo == 'jornada' %}<td><strong>{{ r.nombre }}</strong></td><td>{{ r.fecha|date('d/m/Y') }}</td>{% elseif modulo == 'gol' %}<td><a class="text-link" href="{{ path('app_jugador_show',{id:r.jugador.id}) }}">{{ r.jugador.nombreCompleto }}</a></td><td>{{ r.jugador.equipo.nombre }}</td><td>{{ r.jornada.nombre }}<small>{{ r.jornada.fecha|date('d/m/Y') }}</small></td><td><span class="score">{{ r.cantidad }}</span></td>{% else %}<td><a class="text-link" href="{{ path('app_jugador_show',{id:r.jugador.id}) }}">{{ r.jugador.nombreCompleto }}</a><small>{{ r.jugador.equipo.nombre }}</small></td><td><span class="badge {{ r.tipoTarjeta }}">{{ r.tipoTarjeta|capitalize }}</span></td><td class="description-cell">{{ r.descripcion }}</td><td>{{ r.fechaIncidencia|date('d/m/Y') }}</td><td>{{ r.fechaSuspension ? r.fechaSuspension|date('d/m/Y') : 'No aplica' }}</td>{% endif %}{% if is_granted('ROLE_ADMIN') %}<td><a class="text-link" href="{{ path('app_registro_edit',{modulo:modulo,id:r.id}) }}">Editar →</a></td>{% endif %}</tr>{% else %}<tr><td colspan="{{ (modulo == 'jornada' ? 2 : (modulo == 'gol' ? 4 : 5)) + (is_granted('ROLE_ADMIN') ? 1 : 0) }}" class="empty">Aún no hay registros.{% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_registro_new',{modulo:modulo}) }}">Crear el primer registro →</a>{% endif %}</td></tr>{% endfor %}</tbody></table></div></section>
{% endblock %}
