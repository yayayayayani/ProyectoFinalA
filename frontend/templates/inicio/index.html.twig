{% extends 'base.html.twig' %}
{% import 'ui/icons.html.twig' as ui %}
{% block title %}Inicio{% endblock %}
{% block body %}
<div class="page-heading"><div><p class="eyebrow">EL TORNEO, EN UN SOLO LUGAR</p><h1>Todo listo para jugar.</h1><p class="subtitle">Consulta los equipos, el calendario y los goleadores del torneo.</p></div>{% if is_granted('ROLE_ADMIN') %}<a class="button primary" href="{{ path('app_jugador_new') }}">{{ ui.icon('plus') }} Inscribir jugador</a>{% endif %}</div>
<section class="hero"><div class="hero-copy"><span class="hero-tag"><span class="status-dot"></span> PASIÓN DESDE PEQUEÑOS</span><h2>El próximo gran talento<br>empieza en tu cancha.</h2><p>Equipos, jugadores y resultados. Todo lo que necesitas<br class="desktop-only"> para que el fútbol sea el verdadero protagonista.</p><a class="button light" href="{{ path('app_registro_index', {modulo: 'jornada'}) }}">Ver las jornadas {{ ui.icon('arrow') }}</a></div><div class="pitch-art" aria-hidden="true"><div class="pitch-outline"><div class="pitch-mid"></div><div class="pitch-circle"></div><div class="pitch-box left"></div><div class="pitch-box right"></div><span class="pitch-player p1">7</span><span class="pitch-player p2">10</span><span class="pitch-player p3">9</span><span class="pitch-ball">{{ ui.icon('ball') }}</span></div><span class="pitch-caption">EL FUTURO SE JUEGA HOY.</span></div></section>
<section class="stats-grid" aria-label="Resumen del torneo">
{% for item in [{label:'Equipos inscritos',value:resumen.equipos,icon:'shield',route:path('app_equipo_index')},{label:'Jugadores',value:resumen.jugadores,icon:'users',route:is_granted('ROLE_ARBITRO') ? path('app_jugador_index') : path('app_equipo_index')},{label:'Jornadas',value:resumen.jornadas,icon:'calendar',route:path('app_registro_index',{modulo:'jornada'})},{label:'Goles anotados',value:resumen.goles,icon:'ball',route:is_granted('ROLE_ARBITRO') ? path('app_registro_index',{modulo:'gol'}) : path('app_reporte',{tipo:'goleadores'})}] %}<a class="stat-card" href="{{ item.route }}"><div class="stat-top"><span>{{ item.label }}</span><span class="stat-icon">{{ ui.icon(item.icon) }}</span></div><strong>{{ item.value }}</strong><small>Ver registros <span>↗</span></small></a>{% endfor %}
</section>
{% if is_granted('ROLE_ADMIN') %}<section class="quick-actions" aria-label="Accesos rápidos">
{% if is_granted('ROLE_ADMIN') %}<a class="quick-action" href="{{ path('app_registro_new', {modulo: 'gol'}) }}">{{ ui.icon('ball') }}<span><strong>Registrar goles</strong><small>Actualiza los resultados de la jornada</small></span><span class="arrow">↗</span></a>{% endif %}
{% if is_granted('ROLE_ADMIN') %}<a class="quick-action" href="{{ path('app_registro_new', {modulo: 'incidencia'}) }}">{{ ui.icon('card') }}<span><strong>Registrar incidencia</strong><small>Tarjetas y suspensiones del torneo</small></span><span class="arrow">↗</span></a>{% endif %}
<a class="quick-action" href="{{ path('app_reporte', {tipo: 'arbitro'}) }}">{{ ui.icon('clipboard') }}<span><strong>Preparar la nómina</strong><small>Todo listo para el próximo partido</small></span><span class="arrow">↗</span></a>
</section>{% endif %}
<div class="dashboard-grid"><section class="panel ranking-panel"><div class="panel-heading"><div><span class="eyebrow">LOS PROTAGONISTAS</span><h2>Goleadores del torneo</h2></div><a class="text-link" href="{{ path('app_reporte',{tipo:'goleadores'}) }}">Ver reporte ↗</a></div><div class="table-scroll"><table><thead><tr><th>Pos.</th><th>Jugador</th><th>Equipo</th><th class="numeric">Goles</th></tr></thead><tbody>{% for g in goleadores %}<tr><td><span class="rank {{ loop.first ? 'first' }}">{{ loop.index }}</span></td><td><a class="person" {% if is_granted('ROLE_ARBITRO') %}href="{{ path('app_jugador_show',{id:g.id}) }}"{% endif %}>{{ include('jugador/_fotografia.html.twig',{jugador:g}) }}<strong>{{ g.nombres }} {{ g.apellidos }}</strong></a></td><td>{{ g.equipo }}</td><td class="numeric"><strong class="score">{{ g.total }}</strong></td></tr>{% else %}<tr><td colspan="4" class="empty">El primer gol está por llegar.{% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_registro_new',{modulo:'gol'}) }}">Registrar goles →</a>{% endif %}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="panel"><div class="panel-heading"><div><span class="eyebrow">EN EL CALENDARIO</span><h2>Próximas jornadas</h2></div>{{ ui.icon('calendar') }}</div><div class="schedule-list">{% for j in jornadas %}<a class="schedule-row" href="{{ path('app_registro_index',{modulo:'jornada'}) }}"><span class="date-tile"><strong>{{ j.fecha|date('d') }}</strong><small>{{ j.fecha|date('m / Y') }}</small></span><span><strong>{{ j.nombre }}</strong><small>Fecha de juego · {{ j.fecha|date('d/m/Y') }}</small></span><span class="arrow">↗</span></a>{% else %}<div class="empty">No hay próximas jornadas.{% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_registro_new',{modulo:'jornada'}) }}">Preparar el calendario →</a>{% endif %}</div>{% endfor %}</div>{% if is_granted('ROLE_ARBITRO') %}<a class="panel-footer" href="{{ path('app_reporte',{tipo:'arbitro'}) }}">Preparar nómina del árbitro {{ ui.icon('arrow') }}</a>{% endif %}</section></div>
{% if is_granted('ROLE_ARBITRO') %}<section class="panel recent-panel"><div class="panel-heading"><div><span class="eyebrow">JUEGO LIMPIO</span><h2>Últimas incidencias</h2></div><a class="text-link" href="{{ path('app_registro_index',{modulo:'incidencia'}) }}">Ver todas ↗</a></div><div class="incident-grid">{% for i in incidencias %}<a class="incident-summary" href="{{ path('app_jugador_show',{id:i.jugador.id}) }}"><span class="card-marker {{ i.tipoTarjeta }}"></span><div><strong>{{ i.jugador.nombreCompleto }}</strong><small>{{ i.jugador.equipo.nombre }} · {{ i.fechaIncidencia|date('d/m/Y') }}</small><span class="badge {{ i.tipoTarjeta }}">Tarjeta {{ i.tipoTarjeta }}</span></div></a>{% else %}<p class="empty">Sin incidencias registradas. Que siga el juego limpio.</p>{% endfor %}</div></section>
{% endif %}{% endblock %}
