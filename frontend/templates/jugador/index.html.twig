{% extends 'base.html.twig' %}
{% block title %}Jugadores{% endblock %}
{% block body %}
<div class="page-heading"><div><p class="eyebrow">LOS PROTAGONISTAS</p><h1>Jugadores</h1><p class="subtitle">Cada talento tiene su lugar en el equipo.</p></div>{% if is_granted('ROLE_ADMIN') %}<a class="button primary" href="{{ path('app_jugador_new') }}">+ Inscribir jugador</a>{% endif %}</div>
<form method="get" class="filter-bar"><div><label for="buscar">Buscar jugador</label><input type="search" id="buscar" name="q" value="{{ busqueda }}" placeholder="Nombres o apellidos"></div><div><label for="equipo">Equipo</label><select id="equipo" name="equipo"><option value="0">Todos los equipos</option>{% for e in equipos %}<option value="{{ e.id }}" {{ equipoId == e.id ? 'selected' }}>{{ e.nombre }}</option>{% endfor %}</select></div><button class="button primary">Buscar</button><a class="button secondary" href="{{ path('app_jugador_index') }}">Limpiar</a></form>
<section class="panel"><div class="panel-heading"><h2>Plantilla de jugadores</h2><span class="badge neutral">{{ jugadors|length }} resultados</span></div><div class="table-scroll"><table><thead><tr><th>Jugador</th><th>Equipo</th><th>Nacimiento</th><th>Registro</th><th>Acciones</th></tr></thead><tbody>{% for jugador in jugadors %}<tr><td><a class="person" href="{{ path('app_jugador_show',{id:jugador.id}) }}">{{ include('jugador/_fotografia.html.twig') }}<span><strong>{{ jugador.nombres }} {{ jugador.apellidos }}</strong><small>Jugador del torneo</small></span></a></td><td><span class="team-label">{{ jugador.equipo ? jugador.equipo.nombre : 'Sin equipo' }}</span></td><td>{{ jugador.fechaNacimiento ? jugador.fechaNacimiento|date('d/m/Y') : '—' }}</td><td>#{{ '%03d'|format(jugador.id) }}</td><td class="actions"><a href="{{ path('app_jugador_show',{id:jugador.id}) }}">Ver ficha</a>{% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_jugador_edit',{id:jugador.id}) }}">Editar</a>{% endif %}</td></tr>{% else %}<tr><td colspan="5" class="empty">No hay jugadores para esta búsqueda.{% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_jugador_new') }}">Inscribir un jugador →</a>{% endif %}</td></tr>{% endfor %}</tbody></table></div></section>
{% endblock %}
