{% extends 'base.html.twig' %}{% block title %}{{ equipo.nombre }}{% endblock %}{% block body %}<a class="back-link" href="{{ path('app_equipo_index') }}">← Equipos</a><div class="page-heading"><div><p class="eyebrow">PLANTILLA DEL EQUIPO</p><h1>{{ equipo.nombre }}</h1><p class="subtitle">{{ equipo.jugadors|length }} jugadores inscritos</p></div>{% if is_granted('ROLE_ADMIN') %}<a class="button primary" href="{{ path('app_equipo_edit',{id:equipo.id}) }}">Editar equipo</a>{% endif %}</div><section class="panel"><div class="table-scroll"><table><thead><tr><th>Jugador</th>{% if is_granted('ROLE_ARBITRO') %}<th>Nacimiento</th><th>Ficha</th>{% endif %}</tr></thead><tbody>{% for jugador in equipo.jugadors %}<tr><td><div class="person">{{ include('jugador/_fotografia.html.twig') }}<strong>{{ jugador.nombreCompleto }}</strong></div></td>{% if is_granted('ROLE_ARBITRO') %}<td>{{ jugador.fechaNacimiento|date('d/m/Y') }}</td><td><a class="text-link" href="{{ path('app_jugador_show',{id:jugador.id}) }}">Ver ficha →</a></td>{% endif %}</tr>{% else %}<tr><td colspan="{{ is_granted('ROLE_ARBITRO') ? 3 : 1 }}" class="empty">Este equipo aún no tiene jugadores.{% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_jugador_new') }}">Inscribir jugador →</a>{% endif %}</td></tr>{% endfor %}</tbody></table></div></section><div class="danger-zone">{% if is_granted('ROLE_ADMIN') %}{{ include('equipo/_delete_form.html.twig') }}{% endif %}</div>{% endblock %}
