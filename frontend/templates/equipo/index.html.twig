{% extends 'base.html.twig' %}{% import 'ui/icons.html.twig' as ui %}{% block title %}Equipos{% endblock %}{% block body %}<div class="page-heading"><div><p class="eyebrow">JUNTOS EN LA CANCHA</p><h1>Equipos</h1><p class="subtitle">Los colores que representan a cada jugador.</p></div>{% if is_granted('ROLE_ADMIN') %}<a class="button primary" href="{{ path('app_equipo_new') }}">+ Registrar equipo</a>{% endif %}</div><div class="team-grid">{% for equipo in equipos %}<article class="panel team-card"><div class="team-emblem">{{ ui.icon('shield') }}</div><span class="eyebrow">EQUIPO #{{ '%03d'|format(equipo.id) }}</span><h2>{{ equipo.nombre }}</h2><p>{{ equipo.jugadors|length }} jugadores inscritos</p><div class="team-card-actions"><a class="button secondary" href="{{ path('app_equipo_show',{id:equipo.id}) }}">Ver plantilla →</a>{% if is_granted('ROLE_ADMIN') %}<a class="text-link" href="{{ path('app_equipo_edit',{id:equipo.id}) }}">Editar</a>{% endif %}</div></article>{% else %}<section class="panel empty">El torneo empieza con su primer equipo.{% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_equipo_new') }}">Registrar equipo →</a>{% endif %}</section>{% endfor %}</div>{% endblock %}
