<!DOCTYPE html>
<html lang="es"><head><meta charset="UTF-8"><title>{% block title %}Reporte{% endblock %} · Cantera</title>
<style>
@page { margin: 25px; }
body { font-family: "DejaVu Sans", sans-serif; font-size: 10px; color: #20362e; }
.no-print { display: none; }
h1 { font-size: 23px; margin: 6px 0; } h2 { font-size: 15px; margin: 8px 0; }
.eyebrow, .subtitle, .report-context, .report-footnote { color: #52665b; }
.panel-heading { margin: 18px 0 10px; }
table { border-collapse: collapse; width: 100%; table-layout: fixed; }
th, td { border-bottom: 1px solid #dce4d7; padding: 9px; text-align: left; overflow-wrap: break-word; }
th { background: #eaf2e4; } thead { display: table-header-group; } tr { page-break-inside: avoid; }
small { display: block; color: #52665b; } a { color: inherit; text-decoration: none; }
.numeric { text-align: right; } .player-photo { width: 42px; height: 42px; }
.roja { color: #a12f24; } .green { color: #246449; } .report-footnote { margin-top: 16px; }
.report-footnote span { display: block; } .empty { padding: 25px; text-align: center; }
</style></head><body>{% block body %}{% endblock %}</body></html>
