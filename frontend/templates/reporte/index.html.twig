{% extends 'base.html.twig' %}
{% set titulo = tipo == 'arbitro' ? 'Nómina del árbitro' : (tipo == 'goleadores' ? 'Tabla de goleadores' : 'Informe de incidencias') %}
{% block title %}{{ titulo }}{% endblock %}
{% block body %}
<div class="page-heading"><div><p class="eyebrow">REPORTES DEL TORNEO</p><h1>{{ titulo }}</h1><p class="subtitle">{{ tipo == 'arbitro' ? 'Consulta la plantilla y las suspensiones para la jornada a jugar.' : (tipo == 'goleadores' ? 'Los goles de cada jugador, ordenados de mayor a menor.' : 'Consulta las tarjetas de un equipo o de un jugador en particular.') }}</p></div>{% if listo %}<button class="button primary no-print" data-print>Imprimir / guardar PDF</button>{% endif %}</div>
{{ form_start(form,{attr:{class:'filter-bar no-print'}}) }}{{ form_widget(form) }}<button class="button primary">Consultar</button><a class="button secondary" href="{{ path('app_reporte',{tipo:tipo}) }}">Limpiar</a>{{ form_end(form) }}
{% if listo %}<section class="panel report-panel"><div class="panel-heading"><div><h2>{{ filtros.equipo|default(null) ? filtros.equipo.nombre : 'Todos los equipos' }}</h2><p class="report-context">{% if filtros.jornada|default(null) %}{{ filtros.jornada.nombre }} · {{ filtros.jornada.fecha|date('d/m/Y') }}{% elseif filtros.jugador|default(null) %}{{ filtros.jugador.nombreCompleto }}{% else %}Todos los registros del torneo{% endif %}</p></div><span class="badge neutral">{{ filas|length }} registros</span></div><div class="table-scroll"><table><thead><tr>{% if tipo == 'arbitro' %}<th>Jugador</th><th>Equipo</th><th>Nacimiento</th><th>Estado para la jornada</th>{% elseif tipo == 'goleadores' %}<th>Posición</th><th>Jugador</th><th>Equipo</th><th class="numeric">Total de goles</th>{% else %}<th>Jugador / equipo</th><th>Tarjeta</th><th>Descripción</th><th>Fecha</th><th>Suspensión</th>{% endif %}</tr></thead><tbody>
{% for fila in filas %}<tr>{% if tipo == 'arbitro' %}{% set jugador = fila.jugador %}<td><div class="person">{{ include('jugador/_fotografia.html.twig') }}<span><strong>{{ jugador.nombreCompleto }}</strong><small>#{{ '%03d'|format(jugador.id) }}</small></span></div></td><td>{{ jugador.equipo.nombre }}</td><td>{{ jugador.fechaNacimiento|date('d/m/Y') }}</td><td><span class="badge {{ fila.suspendido ? 'roja' : 'green' }}">{{ fila.suspendido ? 'Suspendido' : 'Habilitado' }}</span></td>{% elseif tipo == 'goleadores' %}<td><span class="rank {{ loop.first ? 'first' }}">{{ loop.index }}</span></td><td><a class="person" href="{{ path('app_jugador_show',{id:fila.id}) }}">{{ include('jugador/_fotografia.html.twig',{jugador:fila}) }}<strong>{{ fila.nombres }} {{ fila.apellidos }}</strong></a></td><td>{{ fila.equipo }}</td><td class="numeric"><strong class="score">{{ fila.total }}</strong></td>{% else %}<td><strong>{{ fila.jugador.nombreCompleto }}</strong><small>{{ fila.jugador.equipo.nombre }}</small></td><td><span class="badge {{ fila.tipoTarjeta }}">{{ fila.tipoTarjeta|capitalize }}</span></td><td class="description-cell">{{ fila.descripcion }}</td><td>{{ fila.fechaIncidencia|date('d/m/Y') }}</td><td>{{ fila.fechaSuspension ? fila.fechaSuspension|date('d/m/Y') : 'No aplica' }}</td>{% endif %}</tr>{% else %}<tr><td colspan="{{ tipo == 'incidencias' ? 5 : 4 }}" class="empty">No hay registros para los filtros seleccionados.</td></tr>{% endfor %}
</tbody></table></div><div class="report-footnote">Cantera · Generado el {{ 'now'|date('d/m/Y H:i', 'America/Guatemala') }}{% if tipo == 'arbitro' %}<span>Las suspensiones corresponden a tarjetas rojas con fecha de suspensión igual a la fecha de esta jornada.</span>{% endif %}</div></section>{% else %}<section class="panel empty"><h2>Prepara tu consulta</h2><p>Selecciona los filtros y pulsa Consultar para generar el reporte.</p></section>{% endif %}
{% endblock %}
